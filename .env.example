# ---- API ----
NODE_ENV=development
PORT=3000
WEB_DIST=../web/dist # client build directory (relative to the api)
WORKER_CWD=../worker # working directory for the worker (relative to the api)
MAX_MEGAPIXELS=100
MAX_QUEUE_DEPTH=10
JOB_TIMEOUT_SECONDS=120
UPLOADS_PER_HOUR=200 # rate limit
PYTHON_BIN=../worker/.venv/Scripts/python.exe # A bare name (`python3`) is looked up on PATH instead.
